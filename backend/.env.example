# Real OpenAI API key. Server-side only, never sent to the browser.
OPENAI_API_KEY=sk-...

# Realtime model used for the voice session
REALTIME_MODEL=gpt-realtime

# Embedding model used for policy chunk + query vectors
EMBEDDING_MODEL=text-embedding-3-small

# Voice the model should speak with
REALTIME_VOICE=alloy

# Port the backend listens on
PORT=8787

# Origin the frontend runs on (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Minimum cosine similarity to treat a retrieved chunk as sufficient evidence
RETRIEVAL_SCORE_THRESHOLD=0.72

# How many top chunks to return per query
RETRIEVAL_TOP_K=4
