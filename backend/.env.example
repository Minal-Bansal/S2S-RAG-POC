# Azure OpenAI resource endpoint (from Azure AI Foundry -> your resource -> Keys and Endpoint)
# e.g. https://your-resource-name.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# Azure OpenAI key (Key 1 from the same Keys and Endpoint page). Server-side only, never sent to the browser.
AZURE_OPENAI_API_KEY=...

# Optional: API version for the (non-realtime) REST calls. Leave default unless Azure asks for a newer one.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployment name you created for the realtime voice model (e.g. gpt-realtime or gpt-realtime-mini)
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-mini

# Deployment name you created for the embeddings model
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Voice the model should speak with
REALTIME_VOICE=alloy

# Port the backend listens on
PORT=8787

# Origin the frontend runs on (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Minimum cosine similarity to treat a retrieved chunk as sufficient evidence.
# text-embedding-3-small cosine scores for genuinely relevant short-text matches
# typically land around 0.35-0.6 (not 0.7+) — calibrate against your own policy
# document rather than assuming a high threshold means "more accurate".
RETRIEVAL_SCORE_THRESHOLD=0.35

# How many top chunks to return per query
RETRIEVAL_TOP_K=4

# Server-side VAD sensitivity for "user started speaking" (used for barge-in).
# API default is 0.5 / 200ms — good for a quiet room or headphones. Raise both
# (e.g. 0.7-0.8 / 400-500ms) if testing with laptop speakers+mic, where the
# assistant's own voice echoing into the mic causes false interruptions.
# Too high, and it'll miss normal speaking volume instead — tune per environment.
VAD_THRESHOLD=0.5
VAD_SILENCE_DURATION_MS=200
